Drop the fdopen-to-NULL platform workarounds

The bundled zlib #defines fdopen to NULL on pre-OS-X MacOS (and
MSDOS/OS/2), a workaround removed in later upstream zlib. On modern
macOS SDKs the macro mangles the fdopen declaration in stdio.h and
the build fails.

--- a/zlib/zutil.h
+++ b/zlib/zutil.h
@@ -125,7 +125,6 @@
 #      include <unix.h> /* for fdopen */
 #    else
 #      ifndef fdopen
-#        define fdopen(fd,mode) NULL /* No fdopen() */
 #      endif
 #    endif
 #  endif
@@ -146,12 +145,10 @@
 #endif
 
 #if defined(_BEOS_) || defined(RISCOS)
-#  define fdopen(fd,mode) NULL /* No fdopen() */
 #endif
 
 #if (defined(_MSC_VER) && (_MSC_VER > 600)) && !defined __INTERIX
 #  if defined(_WIN32_WCE)
-#    define fdopen(fd,mode) NULL /* No fdopen() */
 #    ifndef _PTRDIFF_T_DEFINED
        typedef int ptrdiff_t;
 #      define _PTRDIFF_T_DEFINED
