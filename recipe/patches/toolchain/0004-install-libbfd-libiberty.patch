Install the host bfd/iberty static libraries and headers

The GAP SDK's gen-debug-info (source annotation for GVSOC --trace)
is written against exactly this binutils API (2.28) and upstream
ships it only as a Linux x86-64 ELF; with libbfd.a/bfd.h/libiberty.a
in the prefix it can be rebuilt natively on every platform.
@with_guile@ appears only in the binutils configure stanzas, so the
flags reach nothing else.

--- a/Makefile.in
+++ b/Makefile.in
@@ -93,7 +93,7 @@
 		--prefix=$(INSTALL_DIR) \
 		--with-sysroot=$(SYSROOT) \
 		$(MULTILIB_FLAGS) \
-		@with_guile@ \
+		--enable-install-libbfd --enable-install-libiberty @with_guile@ \
 		--with-python=no \
 		--disable-werror \
 		--disable-nls
@@ -214,7 +214,7 @@
 		--target=$(NEWLIB_TUPLE) \
 		$(CONFIGURE_HOST) \
 		--prefix=$(INSTALL_DIR) \
-		@with_guile@ \
+		--enable-install-libbfd --enable-install-libiberty @with_guile@ \
 		--with-python=no \
 		--disable-werror
 	$(MAKE) -C $(notdir $@)
