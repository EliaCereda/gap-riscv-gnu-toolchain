+#include "config.h"
+#include "system.h"
+#include "coretypes.h"
+#include "hosthooks.h"
+#include "hosthooks-def.h"
+
+/* Unlike the other Darwin hosts, config/host-darwin.h is deliberately not
+   included: it wires the PCH address-space hooks from host-darwin.c, which
+   assume 4 KiB pages, while arm64 Darwin uses 16 KiB pages.  The default
+   host hooks handle PCH through the generic page-size-aware path.  */
+
+const struct host_hooks host_hooks = HOST_HOOKS_INITIALIZER;
--- /dev/null
+++ b/gcc/config/aarch64/x-darwin
@@ -0,0 +1,3 @@
+host-aarch64-darwin.o : $(srcdir)/config/aarch64/host-aarch64-darwin.c
+	$(COMPILE) $<
+	$(POSTCOMPILE)
