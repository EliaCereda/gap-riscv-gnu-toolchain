Add aarch64-darwin host support

gcc 7 predates Apple Silicon: config.host has no case for
aarch64-*-darwin*, so only the generic host-darwin.o (helper functions,
no host_hooks definition) is linked and cc1 fails with an undefined
host_hooks symbol. Add the per-arch host file following the
host-i386-darwin.c pattern, but without wiring the Darwin PCH
address-space hooks, which assume 4 KiB pages (arm64 Darwin uses
16 KiB); the default hooks handle PCH through the generic path.

--- a/gcc/config.host
+++ b/gcc/config.host
@@ -249,6 +249,10 @@
     out_host_hook_obj=host-mingw32.o
     host_lto_plugin_soname=liblto_plugin-0.dll
     ;;
+  aarch64-*-darwin* | arm64-*-darwin*)
+    out_host_hook_obj="${out_host_hook_obj} host-aarch64-darwin.o"
+    host_xmake_file="${host_xmake_file} aarch64/x-darwin"
+    ;;
   i[34567]86-*-darwin* | x86_64-*-darwin*)
     out_host_hook_obj="${out_host_hook_obj} host-i386-darwin.o"
     host_xmake_file="${host_xmake_file} i386/x-darwin"
--- /dev/null
+++ b/gcc/config/aarch64/host-aarch64-darwin.c
@@ -0,0 +1,31 @@
