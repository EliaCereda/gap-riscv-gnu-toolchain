GAP9: zero-extended 5-bit immediates for xori.d/ori.d/andi.d/sltiu.d

GAP9 silicon zero-extends the 5-bit immediate of xori.d, ori.d, andi.d and
sltiu.d (0..31) and sign-extends it for addi.d and slti.d (-16..15), as a
run on a GAP9 EVK shows (gap-llvm-toolchain ROADMAP §5.7). GCC read all of
them as signed (constraint YI), so for unsigned long long x,
`x < 0xfffffffffffffff0ULL` compiled to `sltiu.d a0,a0,-16`, which silicon
runs as `x < 16`.

- <optab>_di3 and *sltu_di take YJ/reg_or_uimm5_operand (0..31); *slt_di
  keeps YI. *sleu_di needs x+1 in 1..31 (sleuint64_operand).
- riscv.c: the DImode immediate checks of riscv_expand_int_scc,
  riscv_emit_int_compare (its GEU path emits sltiu.d directly),
  riscv_int_order_operand_ok_p and riscv_immediate_operand_p depend on the
  code (riscv_imm64_operand_p).
- 16..31 now use the immediate; binutils patch 0004 makes gas accept them.

--- a/gcc/config/riscv/predicates.md
+++ b/gcc/config/riscv/predicates.md
@@ -75,8 +75,8 @@
        (match_test "INTVAL (op) + 1 != 0")))
 
 (define_predicate "sleuint64_operand"
-  (and (match_operand 0 "sleint64_operand")
-       (match_test "INTVAL (op) + 1 != 0")))
+  (and (match_code "const_int")
+       (match_test "UIMM64_OPERAND (INTVAL (op) + 1) && INTVAL (op) + 1 != 0")))
 
 (define_predicate "const_0_operand"
   (and (match_code "const_int,const_wide_int,const_double,const_vector")
--- a/gcc/config/riscv/riscv.c
+++ b/gcc/config/riscv/riscv.c
@@ -1855,6 +1855,31 @@ riscv_legitimize_move (enum machine_mode mode, rtx dest, rtx src)
   return false;
 }
 
+/* Return true if X fits the 5-bit immediate of the Has_64Int .d instruction
+   that implements CODE on DImode operands.  GAP9 silicon zero-extends the
+   immediate of xori.d, ori.d, andi.d and sltiu.d (0..31), and sign-extends
+   it for addi.d and slti.d (-16..15).  The unsigned compares all end up as
+   sltiu.d.  */
+
+static bool
+riscv_imm64_operand_p (enum rtx_code code, HOST_WIDE_INT x)
+{
+  switch (code)
+    {
+    case AND:
+    case IOR:
+    case XOR:
+    case LTU:
+    case LEU:
+    case GTU:
+    case GEU:
+      return UIMM64_OPERAND (x);
+
+    default:
+      return SMALL64_OPERAND (x);
+    }
+}
+
 /* Return true if there is an instruction that implements CODE and accepts
    X as an immediate operand. */
 
@@ -1877,7 +1902,7 @@ riscv_immediate_operand_p (int code, rtx opx, HOST_WIDE_INT x)
     case LT:
     case LTU:
       /* These instructions take 12-bit signed immediates.  */
-      if (Has_64Int && (GET_MODE(opx) == DImode)) return SMALL64_OPERAND(x);
+      if (Has_64Int && (GET_MODE(opx) == DImode)) return riscv_imm64_operand_p ((enum rtx_code) code, x);
       else return SMALL_OPERAND (x);
 
     case LE:
@@ -1887,7 +1912,7 @@ riscv_immediate_operand_p (int code, rtx opx, HOST_WIDE_INT x)
 
     case LEU:
       /* Likewise SLTU, but reject the always-true case.  */
-      if (Has_64Int && (GET_MODE(opx) == DImode)) return (SMALL64_OPERAND(x+1) && (x+1!=0));
+      if (Has_64Int && (GET_MODE(opx) == DImode)) return (UIMM64_OPERAND(x+1) && (x+1!=0));
       else return SMALL_OPERAND (x + 1) && x + 1 != 0;
 
     case GE:
@@ -2490,7 +2515,11 @@ riscv_int_order_operand_ok_p (enum rtx_code code, rtx cmp1, enum machine_mode mo
       return cmp1 == const1_rtx;
 
     case LT:
+      if (Is64) return reg_or_imm5_operand (cmp1, VOIDmode);
+      return arith_operand (cmp1, VOIDmode);
+
     case LTU:
+      if (Is64) return reg_or_uimm5_operand (cmp1, VOIDmode);
       return arith_operand (cmp1, VOIDmode);
 
     case LE:
@@ -2629,9 +2658,9 @@ riscv_emit_int_compare (enum rtx_code *code, rtx *op0, rtx *op1)
 {
 
   if (Has_64Int && (GET_MODE (*op0) == DImode)) {
-	int RightImm = (GET_CODE(*op1) == CONST_INT) && SMALL64_OPERAND(INTVAL(*op1));
+	int RightImm = (GET_CODE(*op1) == CONST_INT) && riscv_imm64_operand_p (*code, INTVAL(*op1));
 
-	if ((GET_CODE(*op1) == CONST_INT) && (INTVAL(*op1) < -16 || INTVAL(*op1) > 15)) {
+	if ((GET_CODE(*op1) == CONST_INT) && !RightImm) {
 		*op1 = force_reg (DImode, *op1); RightImm = 0;
 
 	}
@@ -2809,7 +2838,7 @@ riscv_expand_int_scc (rtx target, enum rtx_code code, rtx op0, rtx op1)
 {
   riscv_extend_comparands (code, &op0, &op1);
   if (Has_64Int && (GET_MODE(op0) == DImode)) {
-	if ((GET_CODE(op1) == CONST_INT) && (INTVAL(op1) < -16 || INTVAL(op1) > 15)) op1 = force_reg (DImode, op1);
+	if ((GET_CODE(op1) == CONST_INT) && !riscv_imm64_operand_p (code, INTVAL(op1))) op1 = force_reg (DImode, op1);
   } else op0 = force_reg (word_mode, op0);
 
   if (code == EQ || code == NE) {
--- a/gcc/config/riscv/riscv.h
+++ b/gcc/config/riscv/riscv.h
@@ -539,6 +539,12 @@ enum reg_class
 #define SMALL64_OPERAND(VALUE) \
   ((unsigned HOST_WIDE_INT) (VALUE) + IMM64_REACH/2 < IMM64_REACH)
 
+/* True if VALUE fits the zero-extended 5-bit immediate of xori.d, ori.d,
+   andi.d and sltiu.d: GAP9 silicon zero-extends it, while addi.d and slti.d
+   sign-extend theirs (SMALL64_OPERAND).  */
+#define UIMM64_OPERAND(VALUE) \
+  ((unsigned HOST_WIDE_INT) (VALUE) < IMM64_REACH)
+
 /* True if VALUE can be loaded into a register using LUI.  */
 
 #define LUI_OPERAND(VALUE)						\
--- a/gcc/config/riscv/riscv.md
+++ b/gcc/config/riscv/riscv.md
@@ -518,6 +518,12 @@
 (define_code_iterator any_lt [lt ltu])
