+;; The 5-bit immediate of the .d compares: slti.d sign-extends it, sltiu.d
+;; zero-extends it (GAP9 silicon), so each code has its own range.
+(define_code_attr d_imm_pred [(lt "reg_or_imm5_operand") (ltu "reg_or_uimm5_operand")])
+(define_code_attr d_imm_cstr [(lt "YI") (ltu "YJ")])
+(define_code_attr d_sle_pred [(le "sleint64_operand") (leu "sleuint64_operand")])
+
