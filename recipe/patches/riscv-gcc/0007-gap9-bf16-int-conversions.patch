+;; No fix_trunc<VMODEFLOAT:vec_type><VMODEFLOAT:int_vec_type>2: vfcvt.x has no
+;; rounding-mode field, and on GAP9 silicon an FP instruction right after a
+;; write to frm still rounds by the old frm, so a frm switch around it isn't
+;; reliable. The vectoriser uses the exact scalar conversions instead.
 
+;; vfcvt.x[u].<h|ah> round by frm. The builtins (v2hftov2hi, v2ohftov2hi and
+;; their _u forms) use this pattern and do that, so it is an unspec, not a unsigned_fix.
 (define_insn "fixuns_trunc<VMODEFLOAT:vec_type><VMODEFLOAT:int_vec_type>2_internal"
   [(set (match_operand:<VMODEFLOAT:int_vec_mode> 0 "register_operand" "=r")
