+        (unspec:<VMODEFLOAT:int_vec_mode> [(match_operand:VMODEFLOAT 1 "register_operand" "xf")] UNSPEC_VFCVT_XU_DYN))]
   "TARGET_HARD_FLOAT"
-  "vfcvt.<VMODEFLOAT:ifmt>u.<VMODEFLOAT:float_vec_size>\t%0,%1\t# f16 Vect to short uint vect, trunc"
