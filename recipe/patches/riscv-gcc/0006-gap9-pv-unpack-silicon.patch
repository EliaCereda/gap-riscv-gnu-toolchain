+;; __builtin_pulp_unpack_h_b_s: returns the low pair (bytes 0 and 1); the
+;; second argument has no effect.
+(define_expand "unpack2_h_b_s"
+  [(match_operand:V2HI 0 "register_operand" "")
+   (match_operand:V4QI 1 "register_operand" "")
+   (match_operand:V2HI 2 "register_operand" "")]
+  "((Pulp_Cpu==PULP_GAP9) && !TARGET_MASK_NOVECT)"
+{
+  rtx pair = gen_reg_rtx (DImode);
+  emit_insn (gen_unpack2_h_b_s_pair (pair, operands[1]));
+  emit_move_insn (operands[0], gen_lowpart (V2HImode, pair));
+  DONE;
+})
+
